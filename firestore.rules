rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.get('email_verified', false) == true || request.auth.token.get('email', '') == 'mehaalkhan.2@gmail.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'mehaalkhan.2@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'fullName', 'classLevel', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.classLevel in ['9th', '10th', '11th', '12th'] &&
             data.role in ['admin', 'student'] &&
             data.createdAt is timestamp &&
             (data.role == 'admin' ? (request.auth.token.get('email', '') == 'mehaalkhan.2@gmail.com' || request.auth.token.email == 'mehaalkhan.2@gmail.com') : true);
    }

    function isValidLecture(data) {
      return data.keys().hasAll(['title', 'date', 'classLevel', 'subject']) &&
             data.title is string && data.title.size() <= 200 &&
             (data.has('videoUrl') ? (data.videoUrl is string && data.videoUrl.size() <= 600) : true) &&
             (data.has('boardImageUrl') ? (data.boardImageUrl is string && data.boardImageUrl.size() <= 2000) : true) &&
             data.date is timestamp &&
             data.classLevel in ['9th', '10th', '11th', '12th'] &&
             data.subject in ['Biology', 'Physics', 'Chemistry', 'Maths', 'Other'];
    }

    function isValidResult(data) {
      return data.keys().hasAll(['studentName', 'studentEmail', 'subject', 'marks', 'totalMarks', 'classLevel', 'date']) &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.studentEmail is string && data.studentEmail.size() <= 100 &&
             data.subject is string && data.subject in ['Biology', 'Physics', 'Chemistry', 'Maths', 'Other'] &&
             data.marks is number && data.totalMarks is number &&
             data.classLevel in ['9th', '10th', '11th', '12th'] &&
             data.date is timestamp;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'pdfUrl', 'date']) &&
             data.title is string && data.title.size() <= 200 &&
             data.pdfUrl is string && data.pdfUrl.size() <= 600 &&
             data.date is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'message', 'date']) &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.date is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role == existing().role || (isAdmin() && incoming().role == 'admin'));
    }

    match /lectures/{lectureId} {
      allow read: if true;
      allow create: if isAdmin() && isValidLecture(incoming());
      allow update: if isAdmin() && isValidLecture(incoming());
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow get: if (isSignedIn() && (isAdmin() || existing().studentEmail == request.auth.token.email)) || true; // Allow lookup
      allow list: if (isSignedIn() && (isAdmin() || (resource != null && resource.data.studentEmail == request.auth.token.email))) || true; // Public lookup
      allow create: if isAdmin() && isValidResult(incoming());
      allow update: if isAdmin() && isValidResult(incoming());
      allow delete: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNote(incoming());
      allow update: if isAdmin() && isValidNote(incoming());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNotification(incoming());
      allow update: if isAdmin() && isValidNotification(incoming());
      allow delete: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
  }
}
